{
  "name": "@macrodetails/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Zod schemas and types shared by the web app and the API",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@macrodetails/config": "workspace:*",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
