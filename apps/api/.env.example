NODE_ENV=development
PORT=4000
# Local (docker-compose): user/password come from the root .env.
#   directConnection=true is required by the mongodb-atlas-local image.
# Atlas: swap the whole URI, e.g.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/macrodetails?retryWrites=true&w=majority
MONGODB_URI=mongodb://macrodetails:local-dev-password@localhost:27017/macrodetails?authSource=admin&directConnection=true
WEB_ORIGIN=http://localhost:3000

# AWS: credentials come from your SSO profile, never from static keys.
AWS_PROFILE=jcc-macro
AWS_REGION=us-east-2
# Outputs of the infra MediaStack (pnpm --filter @macrodetails/infra deploy).
# Leave empty to run without object storage.
MEDIA_BUCKET=
MEDIA_BASE_URL=
